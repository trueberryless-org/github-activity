---
import { ActivityApp } from "../components/ActivityApp";
import "../styles/global.css";

const title = "Recent GitHub Activity";
const description =
  "Browse the recent public GitHub activity of any user: pushes, pull requests, issues, reviews, releases and more.";
const canonical = new URL("/", Astro.site).href;
const image = new URL("/og-image.png", Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="What are you up to?" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <div class="mx-auto flex min-h-dvh max-w-3xl flex-col px-4 sm:px-6">
      <header class="pt-10 pb-8 sm:pt-16">
        <p class="inline-flex items-center gap-2 text-sm font-medium text-sky-300">
          <svg
            aria-hidden="true"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            viewBox="0 0 16 16"
          >
            <path d="M1.5 8.5h3l2-5 3 9 2-4h3"></path>
          </svg>
          Activity viewer
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {title}
        </h1>
        <p class="mt-3 max-w-prose text-zinc-400">
          See what any GitHub user has been up to lately, from pushes and pull
          requests to reviews, releases and stars.
        </p>
      </header>

      <main class="flex-1 pb-16">
        <ActivityApp client:only="react">
          <p slot="fallback" class="text-zinc-400">
            Loading activity…
          </p>
        </ActivityApp>
        <noscript>
          <p class="text-zinc-400">
            This page loads activity directly from the GitHub API and needs
            JavaScript to work.
          </p>
        </noscript>
      </main>

      <footer class="flex flex-col gap-2 border-t border-zinc-800 py-6 text-sm text-zinc-400 sm:flex-row sm:justify-between">
        <p>
          Data from the{" "}
          <a
            class="text-zinc-200 underline underline-offset-2 hover:no-underline"
            href="https://docs.github.com/en/rest/activity/events"
          >
            GitHub API
          </a>
          , cached for one hour.
        </p>
        <p>
          <a
            class="text-zinc-200 underline underline-offset-2 hover:no-underline"
            href="https://github.com/trueberryless-org/recent-github-activity"
          >
            Source code
          </a>{" "}
          by{" "}
          <a
            class="text-zinc-200 underline underline-offset-2 hover:no-underline"
            href="https://felixs.dev"
          >
            trueberryless
          </a>
        </p>
      </footer>
    </div>
  </body>
</html>
